{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://repodium.dev/schemas/evidence.v1.schema.json",
  "title": "Repodium evidence v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._-]+$",
      "maxLength": 160
    },
    "sourceKind": {
      "enum": ["repository", "user_metadata"]
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._-]+$",
      "maxLength": 160
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:\\x00-\\x1f]).+$"
    },
    "locator": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["json-pointer", "yaml-path", "toml-key", "line-range"]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "lineStart": {
          "type": "integer",
          "minimum": 1
        },
        "lineEnd": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["kind", "value"],
      "additionalProperties": false
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "extractorVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "sourceKind",
    "sourceId",
    "safePath",
    "locator",
    "sourceDigest",
    "extractorVersion"
  ],
  "additionalProperties": false
}
