{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://repodium.dev/schemas/presentation.v1.schema.json",
  "title": "Repodium presentation v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._-]+$",
      "maxLength": 160
    },
    "language": {
      "enum": ["en", "vi"]
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._-]+$",
            "maxLength": 160
          },
          "layout": {
            "enum": ["title", "bullets", "summary"]
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "fact-phrase"
                    },
                    "claimId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._-]+$",
                      "maxLength": 160
                    },
                    "templateId": {
                      "enum": [
                        "manifest-declares-dependency",
                        "compose-declares-image",
                        "documentation-quote"
                      ]
                    }
                  },
                  "required": ["kind", "claimId", "templateId"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "editorial-label"
                    },
                    "labelId": {
                      "enum": [
                        "repository-overview",
                        "structure",
                        "technology",
                        "limitations",
                        "context",
                        "engineering-decisions",
                        "features",
                        "roadmap"
                      ]
                    }
                  },
                  "required": ["kind", "labelId"],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": ["id", "layout", "blocks"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "projectId", "language", "slides"],
  "additionalProperties": false
}
