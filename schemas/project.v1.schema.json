{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://repodium.dev/schemas/project.v1.schema.json",
  "title": "Repodium project v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._-]+$",
      "maxLength": 160
    },
    "components": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9._-]+$",
            "maxLength": 160
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "https://repodium.dev/schemas/evidence.v1.schema.json"
      },
      "maxItems": 10000
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "https://repodium.dev/schemas/claim.v1.schema.json"
      },
      "maxItems": 10000
    },
    "coverage": {
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "visited": {
          "type": "integer",
          "minimum": 0
        },
        "admitted": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "uniqueItems": true,
          "maxItems": 100
        }
      },
      "required": ["complete", "visited", "admitted", "skipped", "reasonCodes"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "components",
    "evidence",
    "claims",
    "coverage"
  ],
  "additionalProperties": false
}
